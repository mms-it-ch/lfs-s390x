# Laid over tinyconfig: the kernel of the LFS system itself. What stage 0 has,
# what the book's section 10.3 asks of a kernel that is to run systemd, and
# the devices of this machine - all of it built in, no modules.
#
# Not the book's: no KASLR (RANDOMIZE_BASE), because a kernel that is where
# System.map says it is can be followed in an emulator's trace; and nothing
# of the book's graphics and firmware options, which a machine whose console
# is the service processor has no use for.
CONFIG_MARCH_Z10=y
CONFIG_TUNE_DEFAULT=y
CONFIG_NR_CPUS=2
CONFIG_KERNEL_UNCOMPRESSED=y
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_EXPOLINE is not set
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_SLUB_TINY is not set
# CONFIG_WERROR is not set
# CONFIG_MODULES is not set
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# (the book's STACKPROTECTOR needs a compiler option the host's gcc 13 lacks on s390)

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_KCMP=y
CONFIG_FHANDLE=y
CONFIG_FILE_LOCKING=y
CONFIG_SECCOMP=y
CONFIG_BPF_SYSCALL=y

# systemd: control groups, namespaces, pressure
CONFIG_PSI=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_LEGACY_TIOCSTI is not set

CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SCLP_TTY=y
CONFIG_SCLP_CONSOLE=y
CONFIG_SCLP_VT220_TTY=y
CONFIG_SCLP_VT220_CONSOLE=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_AUTOFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y

CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DASD=y
CONFIG_DASD_ECKD=y
CONFIG_DASD_FBA=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_IBM_PARTITION=y

CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_MULTICAST=y
# QETH wants QDIO and multicast, or it is silently not there
CONFIG_QDIO=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_CTCM=y
CONFIG_LCS=y
CONFIG_QETH=y
CONFIG_QETH_L2=y
CONFIG_QETH_L3=y

CONFIG_CRYPTO=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API_HASH=y
