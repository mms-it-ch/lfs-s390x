#
# The machine of the LFS system: one z/Architecture processor, 1 GB, and the
# 3390 that tools/mklfs.sh wrote - a 3390-3 for a tree of 1.3 GB.
#

ARCHLVL     z/Arch
MAINSIZE    1024
NUMCPU      1
MAXCPU      1
CPUSERIAL   000611
CPUMODEL    8562
LPARNAME    LFS
LOADPARM    ........
PANRATE     FAST

0120 3390 ../build/lfs.ckd
